GNU General Public License for more details.

You should have received a copy of the GNU General Public License
along with this program.  If not, see <http://www.gnu.org/licenses/>.
"""

import argparse
import sys
import os
from pathlib import Path

if __name__ == '__main__':

    # Arguments
    parser = argparse.ArgumentParser(description='Get separately paired reads and singletons from two fastq files (left and right)')
    
    # For backward compatibility, still support positional arguments
    parser.add_argument('leftreads', nargs='?', metavar='leftreads', 
                       help='left reads fastq')
    parser.add_argument('rightreads', nargs='?', metavar='rightreads', 
                       help='right reads fastq')
    
    # Add new-style arguments for compatibility with the new version
    parser.add_argument('-l', '--left', dest='left_file',
                      help='Left reads FASTQ file')
    parser.add_argument('-r', '--right', dest='right_file',
                      help='Right reads FASTQ file')
    parser.add_argument('-o', '--output-dir', dest='output_dir', default='.',
                      help='Output directory for paired and unpaired files')
    
    parser.add_argument('--galaxy', dest='galaxy', action="store_true", default=False, 
                      help="Enable the galaxy mode which create 4 static outputs")
    parser.add_argument('-v', '--verbose', action='store_true',
                      help='Enable verbose output')

    args = parser.parse_args()
    
    # Determine input files using either new-style or old-style arguments
    leftreads = args.left_file if args.left_file else args.leftreads
    rightreads = args.right_file if args.right_file else args.rightreads
    
    if not leftreads or not rightreads:
        parser.error("Must provide left and right FASTQ files")
    
    # Create output directory if provided
    if args.output_dir and args.output_dir != '.':
        os.makedirs(args.output_dir, exist_ok=True)
    
    # Read headers from both files and store in memory
    (n1, n2) = (list(), list())

    for f, n in ((leftreads, n1), (rightreads, n2)):
        with open(f, 'r') as fh:
            c = 0
            for line in fh:
                l = line.strip()
                if l:
                    c += 1
                    if c%4==1:
                        n.append(l.split()[0][1:].split('/')[0])
                        if c%40000==1 and args.verbose:
                            sys.stdout.write("\r%.2f M reads read" % (c/4000000.0))
            if args.verbose:
                sys.stdout.write("\r%.2f M reads read\n" % (c/4000000.0))

    # Find non-common read names
    notcommon = set(n1) ^ set(n2)

    # Process both files to create paired and unpaired output files
    for f in (leftreads, rightreads):
        
        basefilename = '.'.join(f.split('.')[:-1])
        extension = f.split('.')[-1]
        
        if args.galaxy is True:
            extension = "fastq"
            if f == leftreads:
                basefilename = "left"
            else:
                basefilename = "right"
        
        # Create output file paths
        if args.output_dir and args.output_dir != '.':
            output_base = Path(args.output_dir)
            paired_output = output_base / f"{Path(basefilename).name}.paired.{extension}"
            unpaired_output = output_base / f"{Path(basefilename).name}.unpaired.{extension}"
        else:
            paired_output = f"{basefilename}.paired.{extension}"
            unpaired_output = f"{basefilename}.unpaired.{extension}"
        
        # Open output files
        pfh = open(paired_output, 'w')
        ufh = open(unpaired_output, 'w')
        
        # Process the file
        with open(f, 'r') as fh:
            c = 0
            paired = False
            for line in fh:
                l = line.strip()
                if l:
                    c += 1
                    if c%4==1:
                        paired = l.split()[0][1:].split('/')[0] not in notcommon
                        if c%40000==1 and args.verbose:
                            sys.stdout.write("\r%.2f M reads writen" % (c/4000000.0))
                    if paired:
                        pfh.write("%s\n" % l)
                    else:
                        ufh.write("%s\n" % l)
            if args.verbose:
                sys.stdout.write("\r%.2f M reads writen\n" % (c/4000000.0))
                
        # Close output files
        pfh.close()
        ufh.close() 